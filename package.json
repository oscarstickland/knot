{
  "name": "knot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "bun --filter @knot/backend dev",
    "dev:backend:typecheck": "bun --filter @knot/backend typecheck",
    "dev:generate": "cd backend && bun run src/db/populate.ts",
    "dev:frontend": "bun --filter @knot/frontend dev"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "antd": "^6.6.2"
  }
}
